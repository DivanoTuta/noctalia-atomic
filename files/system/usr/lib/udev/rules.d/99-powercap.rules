# Permite al grupo wheel (ej. Mission Center) leer el consumo eléctrico de CPU (RAPL),
# limitando la exposición del canal lateral PLATYPUS (CVE-2020-8694) frente a permisos globales.
ACTION=="add|change", SUBSYSTEM=="powercap", KERNEL=="intel-rapl*", TEST=="energy_uj", RUN+="/usr/bin/chgrp wheel /sys%p/energy_uj", RUN+="/usr/bin/chmod 0440 /sys%p/energy_uj"
