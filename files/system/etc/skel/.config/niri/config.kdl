// Configuración de Niri en formato KDL: https://kdl.dev
// "/-" comenta el nodo siguiente.
// Documentación completa: https://niri-wm.github.io/niri/Configuration:-Introduction

prefer-no-csd

environment {
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "24"
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

input {
    keyboard {
        xkb {
            layout "es"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }
}

layout {
    gaps 16
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

// Inicia Noctalia Shell al arrancar Niri
spawn-at-startup "noctalia"

// Noctalia incluye su propio agente Polkit (activado con polkit_agent = true en config.toml)

hotkey-overlay {
}

screenshot-path "~/Imágenes/Capturas/Captura de %Y-%m-%d %H-%M-%S.png"

animations {
    // Desplazamiento horizontal elástico y suave al cambiar de ventana
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
    }

    // Efecto suave al abrir una ventana nueva
    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    // Movimiento al cambiar una ventana de columna
    window-movement {
        spring damping-ratio=0.80 stiffness=800 epsilon=0.0001
    }
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    open-maximized-to-edges false
}

// Blur realista en Alacritty y en la ventana de actualización (aprovechando su opacidad 0.85)
window-rule {
    match app-id=r#"^Alacritty$"#
    match app-id=r#"^noctalia-system-update$"#
    background-effect {
        blur true
        xray false
    }
}

// Ventana de Ajustes de Noctalia en modo flotante
window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.70; }
}

// Fondo desenfocado de Noctalia en el Overview (Mod+O)
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// Blur realista sin xray en barra, dock, paneles, notificaciones y OSD de Noctalia
layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    background-effect {
        xray false
    }
}

window-rule {
    match app-id=r#"firefox$"# title="^(Picture-in-Picture|Imagen en imagen)$"
    open-floating true
}

// Reproductores de vídeo en tiling panorámico (2/3 de pantalla)
window-rule {
    match app-id=r#"^io\.github\.celluloid_player\.Celluloid$"#
    match app-id=r#"^org\.videolan\.VLC$"#
    match app-id=r#"^vlc$"#
    default-column-width { proportion 0.66667; }
}

// Ventanas auxiliares y de configuración en modo flotante apaisado (landscape)
window-rule {
    match app-id=r#"io\.missioncenter\.MissionCenter$"#
    match app-id=r#"org\.gnome\.baobab$"#
    match app-id=r#"org\.gnome\.Loupe$"#
    match app-id=r#"io\.github\.flattool\.Warehouse$"#
    match app-id=r#"com\.github\.tchx84\.Flatseal$"#
    match app-id=r#"gnome-disks$"#
    match app-id=r#"org\.gnome\.DiskUtility$"#
    match app-id=r#"^[Gg]parted(bin)?$"#
    match app-id=r#"org\.gnome\.FileRoller$"#
    match app-id=r#"pavucontrol$"#
    match app-id=r#"^[Ss]ystem-config-printer(\.py)?$"#
    match app-id=r#"^noctalia-system-update$"#
    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.60; }
}

// Calculadora de GNOME (formato compacto / vertical)
window-rule {
    match app-id=r#"org\.gnome\.Calculator$"#
    open-floating true
    default-column-width { proportion 0.22; }
    default-window-height { proportion 0.45; }
}

// Diálogos de sistema y herramientas compactas (tamaño natural)
window-rule {
    match app-id=r#"nm-connection-editor$"#
    match app-id=r#"nm_connection_editor$"#
    match app-id=r#"^org\.gnome\.seahorse\.Application$"#
    match app-id=r#"blueman-manager$"#
    match app-id=r#"Blueman-manager$"#
    match app-id=r#"io\.github\.seadve\.Kooha$"#
    open-floating true
}

// Diálogos y ventanas secundarias de Steam (inglés y español)
window-rule {
    match app-id=r#"steam$"# title=r#"^(Friends List|Lista de amigos)$"#
    match app-id=r#"steam$"# title=r#"^(Steam - News|Noticias de Steam)$"#
    match app-id=r#"steam$"# title=r#".* - Chat$"#
    match app-id=r#"steam$"# title=r#"^(Settings|Parámetros|Configuración)$"#
    open-floating true
}

binds {
    Mod+F1 { show-hotkey-overlay; }

    // Programas principales: terminal, explorador de archivos, lanzador, paneles y bloqueo
    Mod+T hotkey-overlay-title="Abrir terminal: Alacritty" { spawn "alacritty"; }
    Mod+E hotkey-overlay-title="Abrir gestor de archivos: Nautilus" { spawn "nautilus"; }
    Mod+D hotkey-overlay-title="Lanzar aplicación: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Centro de control: Noctalia" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+Comma hotkey-overlay-title="Ajustes: Noctalia" { spawn "noctalia" "msg" "settings-toggle"; }
    Super+Alt+L hotkey-overlay-title="Bloquear pantalla: Noctalia" { spawn "noctalia" "msg" "session" "lock"; }

    // Controles de volumen, micrófono, multimedia y brillo (con OSD nativo de Noctalia)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    XF86AudioPlay        allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop        allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Alt+Left  { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Plus { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Plus { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Shift+Print hotkey-overlay-title="Capturar y anotar: Noctalia" { spawn "noctalia" "msg" "screenshot-annotate"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}

debug {
    // Permite activar ventanas al hacer clic en notificaciones y el Dock de Noctalia
    honor-xdg-activation-with-invalid-serial
}

include optional=true "~/.cache/niri-vm-quirks.kdl"
include "noctalia.kdl"
